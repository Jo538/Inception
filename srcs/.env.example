# Copy this file to .env and fill in the values.

# Public URL of the app (must match the domain you serve it on)
WP_URL=https://your-login.example.com

# Display name shown in the page header
WP_TITLE="Your Site Title"

WP_ADMIN_USER=choose_a_username
WP_ADMIN_EMAIL=you@example.com

# Second WordPress user (non-administrator)
WP_OTHER_USER=choose_another_username
WP_USER_EMAIL=other@example.com

# Database name and user, shared by the mariadb and wordpress services
DB_NAME=choose_a_database_name
DB_USER=choose_a_database_user
